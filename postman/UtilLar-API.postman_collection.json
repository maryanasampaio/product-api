            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sofá de Teste\",\n  \"description\": \"Descrição de teste com mais de 10 caracteres\",\n  \"price\": 100000,\n  \"costPrice\": 70000,\n  \"condition\": \"novo\",\n  \"category\": \"Sofá\",\n  \"images\": [\"https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=800\"],\n  \"stock\": 5,\n  \"dimensions\": {\n    \"width\": 220,\n    \"height\": 85,\n    \"depth\": 95,\n    \"unit\": \"cm\"\n  },\n  \"material\": \"Tecido\",\n  \"color\": \"Cinza\",\n  \"brand\": \"Util Lar\",\n  \"warranty\": \"90 dias\",\n  \"featured\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      }
    },
